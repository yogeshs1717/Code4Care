# Google Cloud Vision auth — API key for the images:annotate REST endpoint.
# Required: OCR returns 503 OCR_NOT_CONFIGURED while this is unset.
GOOGLE_VISION_API_KEY=

OCR_TIMEOUT_SECONDS=30
# Comma-separated BCP-47 hints, e.g. en,hi. Empty = auto-detect.
OCR_LANGUAGE_HINTS=
MAX_IMAGE_BYTES=10485760

CORS_ALLOW_ORIGINS=http://localhost:5173

# Google AI Studio key for Gemma (gemma-4-31b-it).
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

LLM_TIMEOUT_SECONDS=30

# ── Personalization / auth ─────────────────────────────────────────────────
# JWT signing keys (comma-separated for rotation; first = active signing key).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEYS=
JWT_ACCESS_TOKEN_MINUTES=1440

# Email OTP via Resend (https://resend.com/api-keys).
# Leave RESEND_API_KEY empty in dev → OTP codes print to the server console.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Code4Care <onboarding@resend.dev>
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Database. SQLite default for local dev; PostgreSQL URL in production:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/care
DATABASE_URL=sqlite+aiosqlite:///./backend/data/care.db
