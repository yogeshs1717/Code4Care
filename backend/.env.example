# Google Cloud Vision auth — API key for the images:annotate REST endpoint.
# Required: OCR returns 503 OCR_NOT_CONFIGURED while this is unset.
GOOGLE_VISION_API_KEY=AIzaSyC8VMme8kVPg1e_eSQNdY5i9QPWowYjAIY

OCR_TIMEOUT_SECONDS=30
# Comma-separated BCP-47 hints, e.g. en,hi. Empty = auto-detect.
OCR_LANGUAGE_HINTS=
MAX_IMAGE_BYTES=10485760

CORS_ALLOW_ORIGINS=http://localhost:5173,http://10.0.26.203:5173

